# ============================================================
# K-9 Sentry Kernel — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── AEG-6 Deploy (Foundry) ────────────────────────────────────
DEPLOYER_PK=0x<your-deployer-private-key>
OWNER_ADDRESS=0x<your-owner-EOA-or-multisig>
SESSION_KEY_ADDRESS=0x<k9-sovereign-kernel-signing-key-:8769>

# ── AEG-4 Deployed Contract Addresses ────────────────────────
# From your previous AEG-4 deploy (aeg-protocol repo)
AEG_TREASURY_ADDRESS=0x<AEGTreasury address from AEG-4>
AEG_GOVERNOR_ADDRESS=0x<AEGGovernor address from AEG-4>

# ── Post-AEG-6 (fill after deploy) ───────────────────────────
SESSION_WALLET_ADDRESS=0x<deployed SessionKeyWallet>
VERIFIER_ADDRESS=0x<deployed ProofOfRationalityVerifier>

# ── RPC / API Keys ────────────────────────────────────────────
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org
BASESCAN_API_KEY=<from basescan.org — for --verify flag>

# ── K-9 Runtime ──────────────────────────────────────────────
K9_JEPA_ENDPOINT=http://localhost:8765/route
CIRCUITS_DIR=./contracts/aeg9_circuit
PROOFS_DIR=./proofs

# ── Orbitron / Supabase ───────────────────────────────────────
SUPABASE_URL=https://ziqenqqgnqxqrazmjohs.supabase.co
SUPABASE_ANON_KEY=<from Supabase dashboard>
SUPABASE_SERVICE_KEY=<from Supabase dashboard — keep secret>
ORBITRON_WEBHOOK_URL=<lovable edge function URL for orbitron-bus>
ORBITRON_WEBHOOK_SECRET=<shared secret for orbitron-bus auth>

# ── CB-2 Semantic Cache ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
COHERE_API_KEY=<from cohere.com>

# ── Guardrails ────────────────────────────────────────────────
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_PII=true
GUARDRAILS_TOX_THRESH=0.7

# ── AEG Token Model ──────────────────────────────────────────
AEG_INTEGRATION_KEY=<from api_configurations table in ai-yield-whisperer Supabase>
AEG_NODE_ID=<your Base L2 wallet address>
AEG_OPERATOR_KEY=<Ed25519 key — replace dev before mainnet>

# ── Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=<from Google AI Studio>

# CORS — comma-separated list of allowed origins
# Default includes localhost dev ports; set to your production URLs
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8744

# Gemini agent passthrough — set to enable k9-gemini-agent in router fallback chain
# K9_GEMINI_URL=http://localhost:8770
