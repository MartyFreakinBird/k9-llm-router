# K-9 Docker Compose — secrets and config overrides
# Copy to .env.compose and fill in values
# Usage: docker compose --env-file .env.compose up -d

# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key_here
K9_PG_PASSWORD=strong_password_here

# ── API Keys (cloud fallback) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Optional overrides ────────────────────────────────────────────────────────
ROUTER_MODE=hybrid                   # local | hybrid | cloud
GEMINI_MODEL=gemini-2.5-computer-use-preview
GEMINI_TASK_MODEL=gemini-2.5-pro
BROWSERBASE_API_KEY=                 # leave empty unless using sandboxed browser
ORBITRON_AUTH_TOKEN=                 # Orbitron cloud integration token

# ── Directory overrides (if repos not sibling dirs) ───────────────────────────
# K9_PAYMASTER_DIR=/path/to/k9-paymaster
# K9_MCP_DIR=/path/to/k9-mcp-manager
# K9_ORCH_DIR=/path/to/k9-orchestrator
# ORBITRON_DIR=/path/to/orbitron-integrator
