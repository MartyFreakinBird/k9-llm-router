{
  "version": 2,
  "outputDirectory": "wallpaper",
  "framework": null,
  "rewrites": [
    {
      "source": "/monitor-panel",
      "destination": "/monitor-panel.html"
    },
    {
      "source": "/monitor-panel.html",
      "destination": "/monitor-panel.html"
    },
    {
      "source": "/(.*)",
      "destination": "/wallpaper.html"
    }
  ]
}